{
  "expo": {
    "name": "Lenvry",
    "slug": "lenvry",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/lenvry.png",
    "scheme": "lenvry",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#08090C",
        "foregroundImage": "./assets/lenvry.png",
        "backgroundImage": "./assets/lenvry.png",
        "monochromeImage": "./assets/lenvry.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.adiityanug.lenvry",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMotionUsageDescription": "Lenvry needs access to your motion data to count your daily steps."
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/lenvry.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08090C",
          "image": "./assets/lenvry.png",
          "imageWidth": 120
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/chime.wav",
            "./assets/sounds/digital.wav",
            "./assets/sounds/marimba.wav",
            "./assets/sounds/zen.wav"
          ]
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f9ab2c5c-bdef-49f0-be2d-10f80aad7970"
      }
    },
    "owner": "lenvfry"
  }
}
