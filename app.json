{
  "expo": {
    "name": "Lenvry",
    "slug": "lenvry",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/andro ico.png",
    "scheme": "lenvry",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/andro ico.png",
        "backgroundImage": "./assets/andro ico.png",
        "monochromeImage": "./assets/andro ico.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.adiityanug.lenvry",
      "softwareKeyboardLayoutMode": "adjustResize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/iconfix.ico"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/chime.wav",
            "./assets/sounds/digital.wav",
            "./assets/sounds/marimba.wav",
            "./assets/sounds/zen.wav"
          ]
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "adafb93c-3c57-4fb0-b4af-88ca24d33d19"
      }
    }
  }
}
